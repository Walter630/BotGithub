# Token do seu Telegram Bot (obtenha via @BotFather)
TELEGRAM_TOKEN=seu_token_aqui

# ID do chat onde o bot deve enviar as notificações (use @userinfobot para descobrir)
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Repositório GitHub a monitorar (formato: dono/repositorio)
GITHUB_REPO=owner/repo

# (Opcional) Token de acesso pessoal do GitHub para repositórios privados
GITHUB_TOKEN=

# Branch a monitorar (padrão: main)
GITHUB_BRANCH=main

# Caminho local do repositório onde o git pull será executado (padrão: diretório atual)
REPO_PATH=.

# Intervalo de verificação em segundos (padrão: 60)
CHECK_INTERVAL=60
